#!/bin/bash
# 卸载前：停止服务并清理运行时文件（Socket / PID / 缩略图缓存）。
set -u

PKGVAR="${TRIM_PKGVAR:-/tmp}"
APPDEST="${TRIM_APPDEST:-/tmp}"
LOG_FILE="${PKGVAR}/info.log"
PID_FILE="${PKGVAR}/app.pid"

log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> "${LOG_FILE}" 2>/dev/null; }

log_msg "uninstall_init: stopping service"

if [ -r "${PID_FILE}" ]; then
    p="$(head -n 1 "${PID_FILE}" 2>/dev/null | tr -d '[:space:]')"
    case "$p" in
        ''|*[!0-9]*) ;;
        *)
            kill -TERM "${p}" 2>/dev/null
            sleep 1
            kill -KILL "${p}" 2>/dev/null
            ;;
    esac
fi

rm -f "${PID_FILE}" "${APPDEST}/app.sock"
rm -rf "${PKGVAR}/thumbs" 2>/dev/null

exit 0
